+	mov		x12, #8
+Lkhaje_fb_blk:
+	orr		x13, x9, x11
+	str		x13, [x10], #(1 << TTE_SHIFT)
+	add		x9, x9, #(ARM_TT_L2_SIZE)
+	subs	x12, x12, #1
+	b.ne	Lkhaje_fb_blk
