diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 6928957..97ca7cf 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -11,6 +11,16 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
+#if defined(KHAJE)
+/* KHAJE: the bootstrap framebuffer mapping is a 16K-granule 32MB block and is not ported to
+ * the 4K granule; the normal framebuffer serial console (pe_serial.c) is used instead. */
+void sweet_early_mark(unsigned int stage, const char *label) { (void)stage; (void)label; }
+void sweet_early_putc(char c) { (void)c; }
+void sweet_early_panic(const char *fmt, va_list *args) { (void)fmt; (void)args; }
+void sweet_early_relocate(uint64_t base) { (void)base; }
+void sweet_early_disable(void) { }
+#else /* !KHAJE */
+
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
@@ -140,4 +150,5 @@ sweet_early_disable(void)
 	early_disabled = 1;
 	__asm__ volatile("dsb sy" ::: "memory");
 }
+#endif /* KHAJE */
 #endif /* SWEET */
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..cb1dadb 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -33,8 +33,18 @@
 #define __ARM_DEBUG__             7
 #define __ARM_ENABLE_SWAP__       1
 #define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#if defined(KHAJE)
+/*
+ * KHAJE: Moto G Play 2024 (SM6225, Kryo Silver/Gold = Cortex-A53/A73 class, ARMv8.0).
+ * ID_AA64MMFR0_EL1.TGran16 = 0: no 16K translation granule, and no PAN (ARMv8.1).
+ * Same as Apple's BCM2837 (Raspberry Pi 3) config: 4K hardware pages, sub-page L1.
+ * The VM page size is still 16K at run time (arm_init.c: PAGE_SHIFT_CONST), PAGE_RATIO 4.
+ */
+#define __ARM64_PMAP_SUBPAGE_L1__ 1
+#else
 #define __ARM_PAN_AVAILABLE__     1
 #define __ARM_16K_PG__            1
+#endif
 
 #define HAS_GIC_V3                1
 
